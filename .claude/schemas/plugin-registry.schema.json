{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "plugin-registry.schema.json",
  "title": "Plugin Registry",
  "description": "Global registry tracking all plugins and their current phase state",
  "type": "object",
  "required": ["version", "focused", "plugins"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version for migration support"
    },
    "focused": {
      "type": ["string", "null"],
      "description": "Currently focused plugin name (null if none)"
    },
    "plugins": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/PluginEntry"
      }
    }
  },
  "definitions": {
    "PluginEntry": {
      "type": "object",
      "required": ["path", "stage", "phase", "status", "created"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative path to plugin directory (e.g., plugins/O-IntonationPad)"
        },
        "stage": {
          "type": "string",
          "enum": ["0-ideation", "1-foundation", "2-dsp", "3-gui", "4-polish", "complete"],
          "description": "Current stage in the development lifecycle"
        },
        "phase": {
          "type": ["string", "null"],
          "enum": ["discuss", "research", "plan", "execute", "verify", null],
          "description": "Current phase within the stage (null if stage is complete)"
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused", "blocked", "released", "archived"],
          "description": "Plugin development status"
        },
        "created": {
          "type": "string",
          "format": "date",
          "description": "Creation date (ISO 8601)"
        },
        "lastActivity": {
          "type": "string",
          "format": "date-time",
          "description": "Last activity timestamp (ISO 8601)"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Module dependencies (e.g., ['microtonality@1.2.0'])"
        },
        "expressMode": {
          "type": "boolean",
          "default": false,
          "description": "Whether express mode is enabled for this plugin"
        },
        "blockedBy": {
          "type": ["string", "null"],
          "description": "Description of what's blocking progress (if status is blocked)"
        }
      }
    }
  }
}
