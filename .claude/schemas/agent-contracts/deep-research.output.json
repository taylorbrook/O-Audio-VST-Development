{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deep-research.output",
  "title": "Deep Research Output Contract",
  "description": "Expected outputs from deep-research skill execution",
  "type": "object",
  "required": ["status", "level_reached", "confidence"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["solution_found", "escalated", "no_solution", "applied"],
      "description": "Research outcome"
    },
    "level_reached": {
      "type": "integer",
      "enum": [1, 2, 3],
      "description": "Highest research level completed"
    },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"],
      "description": "Confidence in recommended solution"
    },
    "findings": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "Brief summary of findings"
        },
        "recommended_solution": {
          "type": "string",
          "description": "Primary recommended solution"
        },
        "alternative_solutions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other viable approaches"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["local_docs", "context7", "juce_forum", "github", "web"]
              },
              "reference": { "type": "string" },
              "confidence": {
                "type": "string",
                "enum": ["HIGH", "MEDIUM", "LOW"]
              }
            },
            "additionalProperties": false
          },
          "description": "Sources consulted"
        }
      },
      "additionalProperties": false
    },
    "handoff_to_improve": {
      "type": "boolean",
      "description": "Whether user selected 'Apply solution' (handoff to plugin-improve)"
    },
    "report_path": {
      "type": "string",
      "description": "Path to detailed research report (if saved)"
    },
    "frontmatter_template": {
      "type": "object",
      "description": "Frontmatter template for research documents. Forward-looking: if this skill gains write capability, use this template for any documents written to research/.",
      "properties": {
        "title": { "type": "string", "description": "Descriptive title of the document" },
        "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Creation date (YYYY-MM-DD)" },
        "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Last verification date (YYYY-MM-DD)" },
        "juce_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "JUCE version at time of writing" },
        "summary": { "type": "string", "minLength": 10, "maxLength": 500, "description": "2-3 sentence summary for relevance ranking" },
        "domain": { "type": "string", "enum": ["dsp", "ui", "build", "workflow"], "description": "Document category" },
        "type": { "type": "string", "enum": ["algorithm", "pattern", "guide", "reference"], "description": "Document type" },
        "keywords": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "minItems": 3, "maxItems": 15, "description": "Lowercase hyphenated keywords for discovery" },
        "stages": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 4 }, "minItems": 1, "description": "Pipeline stages (0=ideation, 1=foundation, 2=dsp, 3=gui, 4=polish)" },
        "agents": { "type": "array", "items": { "type": "string", "enum": ["dsp", "ui", "build", "research"] }, "minItems": 1, "description": "Agent roles that benefit from this document" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
