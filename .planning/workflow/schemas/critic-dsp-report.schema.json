{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./critic-dsp-report.schema.json",
  "title": "DSP Critic Report",
  "description": "DSP domain critic feedback with real-time safety, buffer handling, and parameter integration scoring. Extends critic-report.schema.json with DSP-specific scoring categories.",
  "type": "object",
  "required": [
    "critic",
    "plugin",
    "stage",
    "attempt",
    "maxAttempts",
    "timestamp",
    "scores",
    "overallStatus",
    "issues",
    "nextAction"
  ],
  "additionalProperties": false,
  "properties": {
    "critic": {
      "const": "dsp-critic"
    },
    "plugin": {
      "type": "string",
      "description": "Plugin name being evaluated"
    },
    "stage": {
      "type": "string",
      "pattern": "^2-dsp$",
      "description": "Must be 2-dsp stage"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "Current iteration attempt (1-3)"
    },
    "maxAttempts": {
      "type": "integer",
      "const": 3,
      "description": "Maximum allowed iterations"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Report generation time (ISO 8601)"
    },
    "scores": {
      "type": "object",
      "required": ["realtime_safety", "buffer_handling", "parameter_integration"],
      "additionalProperties": false,
      "properties": {
        "realtime_safety": {
          "type": "object",
          "required": ["score", "threshold", "passed"],
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "threshold": {
              "type": "integer",
              "const": 8,
              "description": "Critical for audio software - high threshold"
            },
            "passed": {
              "type": "boolean"
            },
            "details": {
              "type": "string"
            }
          },
          "description": "No allocations, locks, or system calls in processBlock"
        },
        "buffer_handling": {
          "type": "object",
          "required": ["score", "threshold", "passed"],
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "threshold": {
              "type": "integer",
              "const": 7,
              "description": "Important but some slack allowed"
            },
            "passed": {
              "type": "boolean"
            },
            "details": {
              "type": "string"
            }
          },
          "description": "Zero-length buffer checks, channel iteration safety"
        },
        "parameter_integration": {
          "type": "object",
          "required": ["score", "threshold", "passed"],
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "threshold": {
              "type": "integer",
              "const": 6,
              "description": "Can be incomplete initially"
            },
            "passed": {
              "type": "boolean"
            },
            "details": {
              "type": "string"
            }
          },
          "description": "All parameters connected and affecting DSP"
        },
        "numerical_stability": {
          "type": "object",
          "required": ["score", "threshold", "passed"],
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "threshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "passed": {
              "type": "boolean"
            },
            "details": {
              "type": "string"
            }
          },
          "description": "Optional: denormal handling, range clamping"
        },
        "architecture_alignment": {
          "type": "object",
          "required": ["score", "threshold", "passed"],
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "threshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "passed": {
              "type": "boolean"
            },
            "details": {
              "type": "string"
            }
          },
          "description": "Optional: matches parameter-spec.md design"
        }
      }
    },
    "overallStatus": {
      "type": "string",
      "enum": ["PASSED", "NEEDS_FIXES", "ESCALATE"],
      "description": "Overall validation status"
    },
    "overallScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Weighted average of all scores"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "description": "List of identified issues"
    },
    "previousIssueIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]+$"
      },
      "description": "Issue IDs from previous iteration (for no-progress detection)"
    },
    "nextAction": {
      "type": "string",
      "enum": ["gate_pass", "fix_and_resubmit", "escalate_to_user"],
      "description": "Recommended next action based on validation results"
    },
    "tokenMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thisIteration": {
          "type": "integer",
          "minimum": 0,
          "description": "Tokens used in this iteration"
        },
        "cumulative": {
          "type": "integer",
          "minimum": 0,
          "description": "Total tokens used across all iterations"
        },
        "budgetWarning": {
          "type": "boolean",
          "description": "True if cumulative exceeds soft limit"
        }
      },
      "description": "Token usage tracking for cost awareness"
    }
  },
  "$defs": {
    "Issue": {
      "type": "object",
      "required": ["id", "severity", "category", "description", "fixSuggestion"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]+$",
          "description": "Issue identifier (e.g., DSP-001)"
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning"],
          "description": "Issue severity (errors block, warnings proceed with ack)"
        },
        "category": {
          "type": "string",
          "description": "Scoring category this issue affects"
        },
        "location": {
          "type": "string",
          "description": "File and line location (e.g., PluginProcessor.cpp:87)"
        },
        "description": {
          "type": "string",
          "description": "What is wrong"
        },
        "fixSuggestion": {
          "type": "string",
          "minLength": 10,
          "description": "Actionable fix approach (not code snippets)"
        }
      }
    }
  }
}
