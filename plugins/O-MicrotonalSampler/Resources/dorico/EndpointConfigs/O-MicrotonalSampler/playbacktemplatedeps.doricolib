<?xml version="1.0" encoding="utf-8"?>
<kScoreLibrary>
	<expressionMapDefinitions>
		<entities array="true">
			<ExpressionMapDefinition>
				<name>O-MicrotonalSampler</name>
				<entityID>xmap.ouaricon.o_microtonalsampler</entityID>
				<parentEntityID>xmap.default</parentEntityID>
				<inheritanceMask>0</inheritanceMask>
				<creator>Ouaricon Audio</creator>
				<description>O-MicrotonalSampler expression map. Routes Dorico per-note microtonal pitch deltas as VST3 Note Expression (kTuningTypeID — load-bearing for non-Steinberg VST3s; auto routing falls back to pitch-bend and breaks microtonal playback). Maps Dorico's built-in technique notation (Sul pont., Sul tasto, Senza vib., Con sord., Pizz., Harm., Mart., Trem., Flaut.) to the plugin's keyswitch range C-1..A-1 (technique slots 0..9). Dynamics route via CC11 (Expression) — continuously modulates sustained notes. For velocity-only dynamics (short / articulated passages), users can change volumeType to kNoteVelocity in Library → Expression Maps.</description>
				<version>7</version>
				<pluginNames/>
				<autoMutualExclusion>true</autoMutualExclusion>
				<allowMultipleNotesAtSamePitch>false</allowMultipleNotesAtSamePitch>
				<applyStageTemplateSettings>true</applyStageTemplateSettings>
				<pitchBendRange>2</pitchBendRange>
				<microtonalPlaybackMethod>kVST3NoteExpression</microtonalPlaybackMethod>
				<initSwitchData>
					<enabled>true</enabled>
					<initActions array="true"/>
				</initSwitchData>
				<playingTechniqueCombinations array="true">
