<?xml version="1.0" encoding="utf-8"?>
<kScoreLibrary>
	<!--
	  ============================================================================
	  CRITICAL — DO NOT REMOVE TOP-LEVEL <pitchBendRange> + <microtonalPlaybackMethod>
	  ============================================================================
	  Each <ExpressionMapDefinition> below MUST contain BOTH:
	    <pitchBendRange>2</pitchBendRange>
	    <microtonalPlaybackMethod>kVST3NoteExpression</microtonalPlaybackMethod>
	  at the TOP LEVEL (between <applyStageTemplateSettings> and <initSwitchData>).
	  These are LOAD-BEARING for TC-4 microtonal pitch via VST3 Note Expression.

	  Per-combination duplicates of these fields (between <lengthFactor> and
	  <volumeType>) are kept for HSO-factory-shape parity, but DO NOT substitute
	  for the top-level fields — Dorico falls back to nearest-12-TET if the
	  top-level fields are absent, even when per-combination fields are present
	  AND the plugin advertises kTuningTypeID NoteExpression correctly.

	  Regression history (v1.16.0/v1.16.1 PASS → broken multiple times during
	  refactors → re-fixed each time): if you "clean up" these top-level fields
	  thinking they're redundant with per-combination, you will silently break
	  microtonal playback. TC-3 will still pass (bindings look fine); only TC-4
	  reveals the failure.

	  See:
	    plugins/O-MicrotonalSampler/Resources/dorico/SMOKE-TEST.md (TC-4 fail signal)
	    .claude/skills/spike-findings-VST-development/references/vst3-note-expression-dorico.md
	    (Pattern 6 + Landmine 6 — exp-map structural requirements)
	  ============================================================================
	-->
	<expressionMapDefinitions>
		<entities array="true">
			<ExpressionMapDefinition>
				<name>O-MicrotonalSampler — Strings</name>
				<entityID>xmap.ouaricon.o_microtonalsampler</entityID>
				<parentEntityID>xmap.default</parentEntityID>
				<inheritanceMask>0</inheritanceMask>
				<creator>Ouaricon Audio</creator>
				<description>O-MicrotonalSampler Strings expression map. Routes Dorico per-note microtonal pitch deltas as VST3 Note Expression (kTuningTypeID — load-bearing for non-Steinberg VST3s; auto routing falls back to pitch-bend and breaks microtonal playback). Maps Strings techniques (Sul pont., Sul tasto, Stacc., Con sord., Pizz., Harm., Trem.) to keyswitch slots 0..7 (MIDI C-2..G-2 in Dorico's C3=60 convention). Dynamics route via CC11 (Expression). For velocity-only dynamics, change volumeType to kNoteVelocity in Library → Expression Maps.</description>
				<version>10</version>
				<pluginNames/>
				<autoMutualExclusion>true</autoMutualExclusion>
				<allowMultipleNotesAtSamePitch>false</allowMultipleNotesAtSamePitch>
				<applyStageTemplateSettings>true</applyStageTemplateSettings>
				<pitchBendRange>2</pitchBendRange>
				<microtonalPlaybackMethod>kVST3NoteExpression</microtonalPlaybackMethod>
				<initSwitchData>
					<enabled>true</enabled>
					<initActions array="true"/>
				</initSwitchData>
				<playingTechniqueCombinations array="true">
