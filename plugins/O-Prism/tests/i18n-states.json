[
  { "name": "mod-matrix",        "click": ".tab[data-tab=\"mod\"]" },
  { "name": "tuning-circle",     "click": ".tab[data-tab=\"tuning\"]" },
  { "name": "tuning-polar",      "click": ".viz-btn[data-mode=\"polar\"]" },
  { "name": "tuning-matrix",     "click": ".viz-btn[data-mode=\"matrix\"]" },
  { "name": "tuning-truekeys",   "click": ".viz-btn[data-mode=\"truekeys\"]" },
  { "name": "tuning-rotation",   "click": ".viz-btn[data-mode=\"rotation\"]" },
  { "name": "tuning-circle-back", "click": ".viz-btn[data-mode=\"circle\"]" },
  { "name": "tuning-held-notes", "eval": "window.updateHeldNotes([60,64,67],[261.63,329.63,392.00]);" },
  { "name": "tuning-truekeys-held", "click": ".viz-btn[data-mode=\"truekeys\"]" },
  { "name": "tuning-library-open", "click": "#library-header" },
  { "name": "tuning-gen-open",   "click": "#generator-header" },
  { "name": "tuning-gen-harmonic", "eval": "const s=document.getElementById('generator-type'); s.value='harmonic'; s.dispatchEvent(new Event('change',{bubbles:true}));" },
  { "name": "tuning-gen-rank2",  "eval": "const s=document.getElementById('generator-type'); s.value='rank2'; s.dispatchEvent(new Event('change',{bubbles:true}));" },
  { "name": "tuning-gen-edo",    "eval": "const s=document.getElementById('generator-type'); s.value='edo'; s.dispatchEvent(new Event('change',{bubbles:true}));" },
  { "name": "effects",           "click": ".tab[data-tab=\"effects\"]" },
  { "name": "wavetable",         "click": ".tab[data-tab=\"wavetable\"]" },
  { "name": "wt-save-modal",     "click": "#wt-op-save" },
  { "name": "wt-manager-modal",  "eval": "document.getElementById('wt-save-modal-overlay').classList.remove('active'); const sel=window._wtSelectors[0].selectEl; const i=[...sel.options].findIndex(o=>o.dataset.action==='manage'); if(i>=0){ sel.selectedIndex=i; sel.dispatchEvent(new Event('change',{bubbles:true})); }" },
  { "name": "settings-popover",  "eval": "document.getElementById('wt-modal-backdrop').classList.remove('visible'); document.getElementById('wt-save-modal-overlay').classList.remove('active'); document.getElementById('settings-popover').classList.add('visible');" },
  { "name": "preset-save-modal", "eval": "document.getElementById('settings-popover').classList.remove('visible'); document.getElementById('wt-modal-backdrop').classList.remove('visible'); document.getElementById('btn-preset-save').click();" },
  { "name": "preset-menu",       "eval": "document.getElementById('preset-save-modal-overlay').classList.remove('active'); document.getElementById('preset-display').click();" },
  { "name": "synth-lfo-synced",  "eval": "document.getElementById('preset-menu').classList.remove('visible'); document.querySelector('.tab[data-tab=\"synth\"]').click(); for (let i=1;i<=4;i++) document.getElementById('toggle-lfo'+i+'Sync').click();" },
  { "name": "synth-fx-bypassed", "eval": "document.querySelector('.tab[data-tab=\"effects\"]').click(); ['delay','chorus','dist','reverb','eq'].forEach(n => document.getElementById('toggle-'+n+'Bypass').click());" }
]
